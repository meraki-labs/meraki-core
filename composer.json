{
  "name": "merakilab/meraki-core",
  "description": "Meraki Core",
  "type": "library",
  "version": "dev-main",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Meraki\\Core\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Meraki\\Core\\Tests\\": "tests/",
      "Meraki\\Core\\Testing\\": "src/Testing/"
    }
  },
  "authors": [
    {
      "name": "DatPA",
      "email": "datpa@merakilabs.tech"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^v12.0",
    "illuminate/http": "^v12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0",
    "larastan/larastan": "^3.10"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Meraki\\Core\\CoreServiceProvider"
      ],
      "aliases": {
        "Meraki": "Meraki\\Core\\Facades\\Meraki"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
